# Wallet passes for the Marhaba Thailand Opening Ceremony.
# See docs/embassy/wallet-passes.md. Each wallet works independently; leave a
# group blank and its button simply does not appear on the ticket.

# Apple Wallet — needs a paid Apple Developer account.
# The three certificate values are PEM files, base64 encoded.
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_SIGNER_CERT=
APPLE_PASS_SIGNER_KEY=
APPLE_PASS_SIGNER_PASSWORD=
APPLE_WWDR_CERT=

# Google Wallet — free, but the issuer account needs publishing access.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
